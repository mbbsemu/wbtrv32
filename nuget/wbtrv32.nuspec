<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2012/06/nuspec.xsd">
  <metadata>
    <id>MBBSEmu.wbtrv32</id>
    <version>1.0.1</version>
    <title>wbtrv32 Btrieve Sqlite implementation</title>
    <authors>Todd Jeffreys</authors>
    <owners>MBBSEmu.org</owners>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <license type="expression">MIT</license>
    <description>Provides a wbtrv32 implementation on top of sqlite, rather than legacy btrieve.</description>
    <tags>dotnet nuget utility</tags>
    <repository type="git" url="https://github.com/mbbsemu/wbtrv32.git" />
    <readme>README.md</readme>
  </metadata>

  <files>
    <!-- Map compiled binaries into the standard NuGet directory structure.
         $stagingDir$ is supplied via `nuget pack -Properties stagingDir=...`
         by nuget/build_nuget_package.sh, which populates it from bazel's
         per-platform build outputs before packing. -->
    <file src="$stagingDir$/runtimes/linux-arm/native/wbtrv32.so" target="runtimes/linux-arm/native/wbtrv32.so"/>
    <file src="$stagingDir$/runtimes/osx-arm64/native/wbtrv32.dylib" target="runtimes/osx-arm64/native/wbtrv32.dylib"/>
    <file src="$stagingDir$/runtimes/osx-x64/native/wbtrv32.dylib" target="runtimes/osx-x64/native/wbtrv32.dylib"/>
    <file src="$stagingDir$/runtimes/win-x86/native/wbtrv32.dll" target="runtimes/win-x86/native/wbtrv32.dll"/>
    <file src="$stagingDir$/runtimes/win-x64/native/wbtrv32.dll" target="runtimes/win-x64/native/wbtrv32.dll"/>
    <file src="$stagingDir$/runtimes/linux-arm64/native/wbtrv32.so" target="runtimes/linux-arm64/native/wbtrv32.so"/>
    <file src="$stagingDir$/runtimes/linux-x64/native/wbtrv32.so" target="runtimes/linux-x64/native/wbtrv32.so"/>
    <file src="../README.md" target="\" />
  </files>
</package>
