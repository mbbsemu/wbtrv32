bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "gflags", version = "2.3.1")
bazel_dep(name = "googletest", version = "1.18.0")
bazel_dep(name = "rules_cc", version = "0.2.22")

# Fully hermetic GCC + sysroot toolchains used only for cross-compiling to
# arm32/arm64 linux; native x64 builds keep using the local auto-detected
# toolchain. No system cross-compilers or apt packages needed.
bazel_dep(name = "gcc_toolchain", version = "0.12.0")

gcc_toolchains = use_extension("@gcc_toolchain//toolchain:module_extensions.bzl", "gcc_toolchains")
gcc_toolchains.toolchain(
    name = "gcc_toolchain_aarch64",
    target_arch = "aarch64",
)
gcc_toolchains.toolchain(
    name = "gcc_toolchain_armv7",
    target_arch = "armv7",
)
use_repo(gcc_toolchains, "gcc_toolchain_aarch64", "gcc_toolchain_armv7")

register_toolchains(
    "@gcc_toolchain_aarch64//:all",
    "@gcc_toolchain_armv7//:all",
)

# Hermetic zig-cc based toolchain, used only for cross-compiling to Windows
# (wbtrv32.dll); gcc_toolchain above only ships Linux-targeting toolchains.
bazel_dep(name = "hermetic_cc_toolchain", version = "4.3.0")

# Upstream only generates Windows toolchains for amd64/arm64 (see the
# hardcoded loop in toolchain/private/defs.bzl); zig's bundled mingw sysroot
# fully supports x86-windows-gnu (32-bit) too, so patch in a windows_x86
# target the same way upstream builds windows_amd64/windows_arm64.
single_version_override(
    module_name = "hermetic_cc_toolchain",
    version = "4.3.0",
    patches = [
        "//patches:hermetic_cc_toolchain_windows_x86_defs.patch",
        "//patches:hermetic_cc_toolchain_windows_x86_platform.patch",
    ],
    patch_strip = 1,
)

zig_toolchains = use_extension("@hermetic_cc_toolchain//toolchain:ext.bzl", "toolchains")
use_repo(zig_toolchains, "zig_sdk")

register_toolchains(
    "@zig_sdk//toolchain:windows_amd64",
    "@zig_sdk//toolchain:windows_386",
)
