// 26.10.15.5B 11:20PM
// wbtrv32.rc : Windows version information embedded in WBTRV32.DLL, so a
// sysop can see exactly which build is installed (Explorer > Properties >
// Details). Bump the version on every build that leaves this machine.
#pragma code_page(65001)

#include <winver.h>

#include "version.h"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION WBTRV32_VERSION_BIN
 PRODUCTVERSION WBTRV32_VERSION_BIN
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS VS_FF_PRERELEASE
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Sysop Network"
            VALUE "FileDescription", "SQLite driver for The Major BBS v10"
            VALUE "FileVersion", WBTRV32_VERSION_STR
            VALUE "InternalName", "WBTRV32"
            VALUE "LegalCopyright", "Copyright © 2024 The MajorBBS Emulation Project. Copyright © 2026 Sysop Network. MIT License."
            VALUE "OriginalFilename", "WBTRV32.DLL"
            VALUE "ProductName", "WBTRV32 SQLite Driver"
            VALUE "ProductVersion", WBTRV32_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
