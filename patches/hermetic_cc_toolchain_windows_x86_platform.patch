 def declare_platform(gocpu, zigcpu, bzlos, os, suffix = "", extra_constraints = []):
+    # zig calls the 32-bit x86 arch "x86", but @platforms//cpu declares it
+    # as "x86_32" (matching platforms' own naming, unlike x86_64/aarch64
+    # which happen to match zig's names as-is). Platform/toolchain names
+    # still use zigcpu/gocpu as-is so they stay "windows_x86"/"windows_386".
+    platform_cpu = "x86_32" if zigcpu == "x86" else zigcpu
+
     constraint_values = [
         "@platforms//os:{}".format(bzlos),
-        "@platforms//cpu:{}".format(zigcpu),
+        "@platforms//cpu:{}".format(platform_cpu),
     ] + extra_constraints
 
