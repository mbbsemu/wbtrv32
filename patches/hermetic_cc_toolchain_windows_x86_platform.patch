--- a/toolchain/platform/defs.bzl
+++ b/toolchain/platform/defs.bzl
@@ -14,6 +14,12 @@
             for os in oss:
                 declare_platform(gocpu, zigcpu, bzlos, os)
 
+    # 32-bit x86 Windows isn't part of _CPUS above (only amd64/arm64 are),
+    # but zig's mingw sysroot fully supports x86-windows-gnu, so declare it
+    # directly rather than adding it to _CPUS (which would also add
+    # linux/macos x86 platforms nothing here needs).
+    declare_platform("386", "x86", "windows", "windows")
+
     # We can support GOARCH=wasm32 after https://github.com/golang/go/issues/63131
     declare_platform("wasm", "wasm32", "wasi", "wasip1")
     declare_platform("wasm", "wasm32", "none", "none")
@@ -33,9 +39,15 @@
